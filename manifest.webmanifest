{
  "name": "File Org",
  "short_name": "File Org",
  "description": "Company document control: AI naming, site folders, PDF, Word and Excel editors, team chat.",
  "start_url": "/#dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0F1A16",
  "theme_color": "#0F1A16",
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "/icons/logo.svg", "sizes": "any", "type": "image/svg+xml"}
  ],
  "shortcuts": [
    {"name": "AI Upload", "url": "/#upload", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "File Organizer", "url": "/#files"},
    {"name": "Team Chat", "url": "/#chat"}
  ]
}
